{
  "name": "@hey-research-lab/project-manifest",
  "version": "0.1.2",
  "description": "A machine-readable declaration format (/.well-known/hey-project.json) for Robinhood Chain projects: JSON Schema, TypeScript types, validator and CLI. Declared, not verified.",
  "license": "MIT",
  "author": "HEY Research Lab",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema/hey-project.v1.json": "./schema/hey-project.v1.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "hey-project": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-research-lab/hey-project-manifest.git"
  },
  "homepage": "https://heyresearch.xyz/developers",
  "bugs": {
    "url": "https://github.com/hey-research-lab/hey-project-manifest/issues"
  },
  "keywords": [
    "hey-research",
    "robinhood-chain",
    "manifest",
    "well-known",
    "json-schema",
    "cli",
    "evm",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "scan": "node scripts/scan.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
